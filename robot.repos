# Real-robot packages (ODrive hardware interface etc.).
# Usage (host, in ~/dev/cora/cora_ws):  vcs import src < robot.repos
# Pins cora_common to the commit cora_robot's submodule points to (2026-02-10),
# which is OLDER than the one cora_desktop's submodule pins (161ee79). Don't
# fetch cora_robot's submodule (no --recursive) and don't import desktop.repos
# into the same workspace: either one adds a second cora_common copy. Use a
# separate workspace until the cora_common versions are aligned.
repositories:
  cora_common:
    type: git
    url: git@github.com:C-O-R-A/cora_common.git
    version: c2d65187bf815c8d27997db57af19b9af5ff4967
  cora_robot:
    type: git
    url: git@github.com:C-O-R-A/cora_robot.git
    version: main
