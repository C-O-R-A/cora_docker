# Desktop / simulation development.
# Usage (host, in ~/dev/cora/cora_ws):
#   vcs import src < desktop.repos
#   git -C src/cora_desktop submodule update --init --recursive
# cora_common is not listed here: it comes as the cora_common submodule of
# cora_desktop (src/cora_desktop/cora_common), at the commit cora_desktop pins.
# setup.sh runs both commands for you. Don't import robot.repos into the same
# workspace: it adds a second cora_common copy.
repositories:
  cora_desktop:
    type: git
    url: git@github.com:C-O-R-A/cora_desktop.git
    version: main
