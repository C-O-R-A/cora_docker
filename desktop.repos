# Desktop / simulation development.
# Usage (host, in ~/dev/cora/cora_ws):
#   mkdir -p src && vcs import src < desktop.repos
#   git -C src/cora_desktop submodule update --init --recursive
# cora_common comes in as a submodule of cora_desktop (src/cora_desktop/cora_common).
repositories:
  cora_desktop:
    type: git
    url: git@github.com:C-O-R-A/cora_desktop.git
    version: main
