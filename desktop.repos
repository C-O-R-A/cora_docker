# Desktop / simulation development.
# Usage (host, in ~/dev/cora/cora_ws):  vcs import src < desktop.repos
# Do NOT pass --recursive: cora_desktop's cora_common submodule would be cloned
# as a second copy of the same packages. The top-level cora_common below is the
# only copy that gets built.
repositories:
  cora_desktop:
    type: git
    url: git@github.com:C-O-R-A/cora_desktop.git
    version: main
